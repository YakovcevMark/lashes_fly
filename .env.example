# Local PostgreSQL. Use a matching password in both settings.
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql://lashes:local_dev_only@127.0.0.1:5432/lashes_fly
PORT=3000

# Exact Telegram OIDC callback, including its trailing slash.
ADMIN_URL=http://localhost:5173/
MASTER_TELEGRAM_ID=
SESSION_TTL_DAYS=7
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Used by yarn bot:check to verify the configured test bot.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Local Vite proxy uses /api/v1. For Pages set the absolute HTTPS API base in GitHub Variables.
VITE_API_BASE_URL=/api/v1
